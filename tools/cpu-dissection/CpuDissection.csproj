<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Ticket #47's dissection bench (tests/performance/FINDINGS.md §15). Not an emulator and not part of
    the machine: it links the CPU's own sources and the machine's own log types, and supplies the rest
    of the world — one chip, one trace, one queue.

    A and B are those linked sources in two modes; C and D are generated from them by gen.py, which is
    why they cannot drift from the code they price. Run `python3 gen.py` before building.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>cpu-dissection</AssemblyName>
    <RootNamespace>TheST.Dissect</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- This bench compiles the CPU's sources itself, so it needs the machine's lowering or it prices a
         different compilation than the machine ships (#65 L1, FINDINGS §19). Kept in step with
         src/TheST.Machine/TheST.Machine.csproj by hand: a Roslyn feature flag, not an SDK property. -->
    <Features>runtime-async=on</Features>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Engine.cs" />
    <Compile Include="Chip.cs" />
    <Compile Include="Trace.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- the machine's own types, linked and unmodified -->
    <Compile Include="../../src/TheST.Machine/Channel.cs" Link="Linked/Channel.cs" />
    <Compile Include="../../src/TheST.Machine/Channels.cs" Link="Linked/Channels.cs" />
    <Compile Include="../../src/TheST.Machine/Wires.cs" Link="Linked/Wires.cs" />
    <Compile Include="../../src/TheST.Machine/Record.cs" Link="Linked/Record.cs" />
    <Compile Include="../../src/TheST.Machine/ValueLog.cs" Link="Linked/ValueLog.cs" />
    <!-- variants A and B: the CPU, unmodified -->
    <Compile Include="../../src/TheST.Machine/Cpu/M68000.cs" Link="Linked/M68000.cs" />
    <Compile Include="../../src/TheST.Machine/Cpu/M68000.Instructions.cs" Link="Linked/M68000.Instructions.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- variants C and D: generated by gen.py from the same two files -->
    <Compile Include="Gen/**/*.cs" />
  </ItemGroup>

</Project>
