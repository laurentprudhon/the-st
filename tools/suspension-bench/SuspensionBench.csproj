<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Suspension-cost prototype for ticket #8 (see README.md).
    The shipping configuration is the default one: compiler-generated state machines, default
    tiering, workstation GC. Runtime-async is opt-in per build:
      dotnet build -c Release -p:Features=runtime-async=on -o out-ra
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <AssemblyName>SuspensionBench</AssemblyName>
    <RootNamespace>TheST.SuspensionBench</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
