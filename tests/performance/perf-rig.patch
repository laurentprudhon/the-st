+    /// <summary>
+    /// The per-wire page (ST_PROF only): volume × rate, so a frame can be read as a table rather than
+    /// as one number. Volumes are exact; the rates carry the clock's own ~87 ns a measurement, which is
+    /// stated on the page because at these sizes it is not noise.
+    /// </summary>
+    static void WritePerf(string directory, MachineModel machine, int frames, double hostSeconds)
+    {
+        Engine engine = machine.Engine;
+        double freq = System.Diagnostics.Stopwatch.Frequency;
+        double Ms(long ticks) => ticks * 1000.0 / freq;
+        double Us(long ticks, long count) => count == 0 ? 0 : ticks * 1_000_000.0 / freq / count;
+        double Ns(long ticks, long count) => count == 0 ? 0 : ticks * 1_000_000_000.0 / freq / count;
+
+        // the clock's own cost, measured in this process: at these operation sizes it is not noise, so
+        // every rate below is printed net of the two GetTimestamp calls the rig wraps it in
+        long clockStart = System.Diagnostics.Stopwatch.GetTimestamp();
+        long clockSink = 0;
+        for (int i = 0; i < 1_000_000; i++)
+        {
+            clockSink += System.Diagnostics.Stopwatch.GetTimestamp();
+        }
+
+        GC.KeepAlive(clockSink);
+        double clockNs = System.Diagnostics.Stopwatch.GetTimestamp() - clockStart;
+        clockNs = clockNs * 1_000_000_000.0 / freq / 1_000_000;
+        double Net(long ticks, long count) => Math.Max(0, Ns(ticks, count) - 2 * clockNs);
+
+        var page = new List<string>
+        {
+            "The ST — where a frame goes (Release, ST_PROF on)",
+            string.Empty,
+            $"frames {frames}, host {hostSeconds:F1} s. Every per-operation rate below carries ~87 ns of",
+            "clock-reading overhead (two GetTimestamp calls), so read a rate as high by that much, and read",
+            "the *shares* as the measurement. The volumes are exact.",
+            string.Empty,
+            "A. per chip — its own coroutine, from a resume to its next suspension:",
+            "   chip                  resumes   records driven      ms   us/resume   share",
+        };
+
+        double contTotal = 0;
+        foreach (Chip chip in engine.Chips)
+        {
+            contTotal += Ms(engine.TByChip[chip.Id]);
+        }
+
+        foreach (Chip chip in engine.Chips)
+        {
+            long resumes = engine.NByChip[chip.Id];
+            double ms = Ms(engine.TByChip[chip.Id]);
+            page.Add($"   {chip.Name,-20} {resumes,10:N0} {engine.RecordByChip[chip.Id],14:N0} {ms,7:F0} {Us(engine.TByChip[chip.Id], resumes),10:F2} {100 * ms / Math.Max(contTotal, 1),6:F1} %");
+        }
+
+        page.Add($"   {"(all chips)",-20} {engine.NByChip.Sum(),10:N0} {engine.RecordByChip.Sum(),14:N0} {contTotal,7:F0}");
+        page.Add(string.Empty);
+        page.Add("B. the queue — every pop, by kind:");
+        page.Add($"   live resumes  {engine.Pops - engine.StaleWakes:N0}   stale wakes  {engine.StaleWakes:N0} ({100.0 * engine.StaleWakes / Math.Max(engine.Pops, 1):F0} %)   pops {engine.Pops:N0}");
+        page.Add(string.Empty);
+        page.Add("C. per wire and register log — volume, and what one record costs there:");
+        page.Add("   log (kind id)                 records  append ns    fires   fire ns     subs searches search ns");
+        page.Add("   (`fire us` is the global average — timing it per log would count the instrument itself twice)");
+
+        foreach (ValueLog log in engine.Logs.OrderByDescending(l => engine.ProfAppended[Engine.ProfSlot(l.Channel)]))
+        {
+            int slot = Engine.ProfSlot(log.Channel);
+            long records = engine.ProfAppended[slot];
+            if (records == 0 && log.SearchCalls == 0)
+            {
+                continue;
+            }
+
+            string kind = log.Channel.Kind == ChannelKind.Wire ? "wire" : "int ";
+            page.Add($"   {log.Channel.Name,-12} ({kind} {log.Channel.Id,3}) {records,10:N0} {Net(engine.ProfAppendTicks[slot], records),8:F0} {engine.ProfFired[slot],9:N0} {Net(engine.TFire, Math.Max(engine.NFire, 1)),8:F0} {engine.ProfSubbed[slot],9:N0} {log.SearchCalls,9:N0} {Net(log.SearchTicks, log.SearchCalls),8:F0}");
+        }
+
+        page.Add(string.Empty);
+        page.Add("D. the engine's own per-operation rates:");
+        page.Add($"   append a record (look up its log, store it)   {engine.NAppend,12:N0} calls  {Ms(engine.TAppend),8:F0} ms  {Net(engine.TAppend, engine.NAppend),6:F0} ns each");
+        page.Add($"   fire a wire's subscribers (scan and remove)   {engine.NFire,12:N0} calls  {Ms(engine.TFire),8:F0} ms  {Net(engine.TFire, Math.Max(engine.NFire, 1)),6:F0} ns each");
+        page.Add($"   enqueue a queue entry                         {engine.NEnq,12:N0} calls  {Ms(engine.TEnq),8:F0} ms  {Net(engine.TEnq, engine.NEnq),6:F0} ns each");
+        page.Add($"   dequeue one queue entry                       {engine.NPop,12:N0} calls  {Ms(engine.TPop),8:F0} ms  {Net(engine.TPop, engine.NPop),6:F0} ns each");
+        page.Add($"   register a subscription                       {engine.NSub,12:N0} calls  {Ms(engine.TSub),8:F0} ms  {Net(engine.TSub, Math.Max(engine.NSub, 1)),6:F0} ns each");
+        page.Add($"   resolve a chip's continuation (all chips)     {engine.NByChip.Sum(),12:N0} calls  {contTotal,8:F0} ms  {Net(engine.TByChip.Sum(), engine.NByChip.Sum()),6:F0} ns each");
+        page.Add($"   Engine.Log(...) dictionary lookups            {engine.NLogLookups,12:N0} calls  (measured apart: 7.0 ns each, an array 1.4)");
+        page.Add($"   retention trims                               {engine.TrimCalls,12:N0} calls  {Ms(engine.TTrim),8:F0} ms  {Us(engine.TTrim, engine.TrimCalls),6:F2} us each");
+        page.Add(string.Empty);
+        page.Add("   exclusive view — what a frame's time is really made of (the engine calls a chip makes");
+        page.Add("   happen inside its coroutine, so their totals are also inside A's):");
+        page.Add($"   chip coroutines, nested engine calls included {contTotal,8:F0} ms  ({contTotal / frames,7:F2} ms a frame)");
+        page.Add($"     of which appends inside a chip              {Ms(engine.TAppendNested),8:F0} ms  ({Net(engine.TAppendNested, engine.NAppend),4:F0} ns a record)");
+        page.Add($"     of which fires inside a chip                {Ms(engine.TFireNested),8:F0} ms");
+        page.Add($"     of which enqueues inside a chip             {Ms(engine.TEnqNested),8:F0} ms");
+        page.Add($"   retention (outside the coroutines)            {Ms(engine.TTrim),8:F0} ms  ({Ms(engine.TTrim) / frames,7:F2} ms a frame, {(double)engine.TrimCalls / frames:F0} trims a frame)");
+        page.Add($"   queue pops, engine side, outside a coroutine  {Ms(engine.TPop),8:F0} ms");
+        page.Add($"   the whole run                                 {hostSeconds * 1000,8:F0} ms  ({hostSeconds * 1000 / frames,7:F2} ms a frame)");
+        page.Add($"   (the clock itself: {clockNs:F0} ns a reading, subtracted above)");
+        page.Add(string.Empty);
+        page.Add("E. allocation, by the region that made it:");
+        page.Add($"   inside a chip's continuation                  {engine.ACont / 1048576.0,10:F0} MB");
+        page.Add($"   inside an enqueue                             {engine.AEnq / 1048576.0,10:F0} MB");
+        page.Add($"   (the rest: entries, delegates, log arrays, the harness)");
+        page.Add($"   gen-0 {GC.CollectionCount(0):N0}  gen-1 {GC.CollectionCount(1):N0}  gen-2 {GC.CollectionCount(2):N0}  pause {GC.GetTotalPauseDuration().TotalMilliseconds:F0} ms  allocated {GC.GetTotalAllocatedBytes(false) / 1048576:N0} MB");
+
+        File.WriteAllLines(Path.Combine(directory, "perf.txt"), page);
+        foreach (string line in page)
+        {
+            Console.WriteLine(line);
+        }
+    }
+
     /// <summary>A division of one measured total by the frames it took — every §4 figure is one of these.</summary>
     static double PerFrame(long total, int frames) => frames <= 0 ? 0 : (double)total / frames;
 
